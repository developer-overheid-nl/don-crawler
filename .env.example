API_BASEURL=http://localhost:1337/v1/
API_X_API_KEY=

# Optional Keycloak client credentials
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_TOKEN_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# GitHub App. For multiline PEM, use \\n for newlines.
GIT_OAUTH_CLIENTID=
GIT_OAUTH_INSTALLATION_ID=
GIT_OAUTH_SECRET=
GITHUB_API_VERSION=2022-11-28

# Optional runtime configuration
DATADIR=/app/data
ACTIVITY_DAYS=60
CLEANUP_GIT_CLONES=true
# Supported values: debug, info, warn, error
LOG_LEVEL=info
ENABLE_FILE_LOG=false
LOG_FILE=
